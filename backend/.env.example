# Copy this file to .env and fill in your values
# Supabase PostgreSQL connection URL
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT secret for signing tokens
JWT_SECRET=your-jwt-secret-here

# Optional: OpenDroneMap token
ODM_TOKEN=

# Optional: GEE credentials
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
