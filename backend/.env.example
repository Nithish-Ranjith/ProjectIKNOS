# Copy this file to .env and fill in your values
# Supabase PostgreSQL connection URL
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pool_pre_ping=true

# JWT secret for signing tokens (App local)
IKNOS_SECRET_KEY=your-jwt-secret-here

# JWT secret from Supabase (Dashboard -> Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Demo mode (enables X-Demo-Email auth bypass and fake AI boundaries)
IKNOS_DEMO=1

# Optional: OpenDroneMap token
WEBODM_TOKEN=
WEBODM_URL=http://webodm:8080

# Optional: GEE credentials
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
